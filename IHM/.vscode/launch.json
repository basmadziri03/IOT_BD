{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MQTT lecture",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/console_mqtt_lecture/main.py",
            "cwd": "${workspaceFolder}/console_mqtt_lecture",
            "console": "externalTerminal"
        },
        {
            "name": "MQTT ecriture",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/console_mqtt_ecriture/main.py",
            "cwd": "${workspaceFolder}/console_mqtt_ecriture",
            "console": "externalTerminal"
        },
        {
            "name": "MQTT thread (3.6)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/console_mqtt_thread/main.py",
            "cwd": "${workspaceFolder}/console_mqtt_thread",
            "console": "externalTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Lecture + Ecriture (3.5)",
            "configurations": ["MQTT lecture", "MQTT ecriture"],
            "stopAll": true
        }
    ]
